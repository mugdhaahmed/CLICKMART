# =========================================================
# Local development environment (loaded by python-decouple)
# Copy this file to ".env" and fill in your own values.
# =========================================================

# <--- Django --->
SECRET_KEY='your-django-secret-key'
DEBUG=True

# <--- Database Credentials (PostgreSQL) --->
DB_NAME='your_db_name'
DB_USER='postgres'
DB_PASS='your_db_password'
DB_HOST='localhost'
DB_PORT='5432'

# <--- JWT Setup --->
ACCESS_TOKEN_EXPIRY=180        # access token lifetime in minutes
REFRESH_TOKEN_EXPIRY=7         # refresh token lifetime in days

# <--- Email Setup (Gmail SMTP) --->
# Use a Gmail App Password (NOT your account password).
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password


# =========================================================
# Production-only (e.g. Render) — NOT needed for local dev.
# Set these in your host's dashboard; listed here as documentation.
# =========================================================
# DEBUG=False
# ALLOWED_HOSTS='your-backend.onrender.com'              # comma-separated
#
# In production, set DATABASE_URL instead of the DB_* vars above (e.g. Neon).
# It takes priority over DB_* when present:
# DATABASE_URL='postgresql://user:pass@host/dbname?sslmode=require'
#
# Cloudinary stores uploaded media (the host's disk is ephemeral):
# CLOUDINARY_URL='cloudinary://API_KEY:API_SECRET@CLOUD_NAME'
#
# Frontend origin(s) allowed to call the API / trusted for admin CSRF:
# CORS_ALLOWED_ORIGINS='https://your-frontend.onrender.com'   # comma-separated
# CSRF_TRUSTED_ORIGINS='https://your-frontend.onrender.com'   # comma-separated
#
# Optional HSTS max-age in seconds (applied only when DEBUG=False):
# SECURE_HSTS_SECONDS=31536000
#
# On Render, RENDER_EXTERNAL_HOSTNAME is injected automatically and added to
# ALLOWED_HOSTS / CSRF_TRUSTED_ORIGINS for you — no need to set it.
