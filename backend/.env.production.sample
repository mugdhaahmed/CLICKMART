# =========================================================
# Postgres container environment
# Loaded by the "db" (PostgreSQL) service in docker-compose.yml.
# Copy this file to ".env.production" and fill in your own values.
# Note: DB_PASSWORD here must match DB_PASS used by the backend service.
# =========================================================

DB_NAME='your_db_name'
DB_USER='postgres'
DB_PASSWORD='your_db_password'
