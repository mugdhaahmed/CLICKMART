# =========================================================
# Backend container environment
# Loaded by the "backend" (Django) service in docker-compose.yml.
# Copy this file to ".env.docker" and fill in your own values.
# =========================================================

# <--- Django --->
SECRET_KEY='your-django-secret-key'
DEBUG=True

# <--- Database Credentials (PostgreSQL) --->
# DB_HOST must match the Postgres service name in docker-compose.yml (here: "db").
# DB_PASS must equal DB_PASSWORD in .env.production (same database password).
DB_NAME='your_db_name'
DB_USER='postgres'
DB_PASS='your_db_password'
DB_HOST='db'
DB_PORT='5432'

# <--- JWT Setup --->
ACCESS_TOKEN_EXPIRY=180        # access token lifetime in minutes
REFRESH_TOKEN_EXPIRY=7         # refresh token lifetime in days

# <--- Email Setup (Gmail SMTP) --->
# Use a Gmail App Password (NOT your account password).
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
